<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- Version Information -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0 - Compatible with IndxCloudApi 1.0</InformationalVersion>

    <!-- Project Metadata -->
    <Authors>Indx</Authors>
    <Company>Bionic</Company>
    <Product>IndxCloudLoader</Product>
    <Description>Data loader tool for IndxCloudApi - Load and configure datasets with pre-configured field settings</Description>
    <Copyright>Copyright © 2025 Indx (Bionic AS)</Copyright>

    <!-- Open Source -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/bionic-as/IndxCloudLoader</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>search;indx;data-loader;dataset;json;search-engine</PackageTags>
    <PackageProjectUrl>https://github.com/bionic-as/IndxCloudLoader</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;IDE0059;CA1861;CA1869</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;IDE0059;CA1861;CA1869</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

</Project>
